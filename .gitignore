# ==========================================================
# Studio Manager – .gitignore
# Files Git must never track. See SECURITY.md for the reasoning.
# ==========================================================

# --- Secrets & environment variables ----------------------
# Real keys live ONLY in local .env files and in the hosting
# provider's settings. Never in the repository.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Personal & business data -----------------------------
# Receipts, accountant exports, customer data and image
# originals belong in the database/storage, not in Git.
data/
exports/
uploads/
receipts/
*.sie
*.se
*.si
*.xlsx
*.numbers

# --- Dependencies -----------------------------------------
node_modules/
.pnp
.pnp.*

# --- Next.js / build output -------------------------------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# --- Hosting & local tooling ------------------------------
.vercel
supabase/.temp/
supabase/.branches/

# --- Testing ----------------------------------------------
coverage/

# --- Logs -------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS & editor ------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json